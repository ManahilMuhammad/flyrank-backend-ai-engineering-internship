{
  "openapi": "3.0.3",
  "info": {
    "title": "Priors API",
    "version": "0.1.0",
    "description": "Maps the third-party sources an AI engine retrieves for a category, audits how a brand is described in each, and ranks off-site actions by leverage.\n\n**To try authenticated routes:** call `POST /auth/login`, copy `access_token`, click **Authorize** and paste it."
  },
  "servers": [
    {
      "url": "http://localhost:3010",
      "description": "Development server"
    }
  ],
  "tags": [
    { "name": "General" },
    { "name": "Auth" },
    { "name": "Workspaces", "description": "A workspace is a tenant. Everything a client owns lives under one." },
    { "name": "Brands", "description": "The brand whose standing is audited. `fact_sheet` is the ground truth used to detect stale descriptions." },
    { "name": "Categories", "description": "A product category to map, tied to one brand in the same workspace." },
    { "name": "Queries", "description": "The conversational prompts a category is measured with. Generated by the LLM in groups of paraphrases, or added by hand." }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token from POST /auth/login"
      }
    },
    "parameters": {
      "workspaceId": {
        "name": "workspaceId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "brandId": {
        "name": "brandId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "categoryId": {
        "name": "categoryId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "queryId": {
        "name": "queryId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Invalid request body" },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": { "type": "string", "example": "name" },
                "message": { "type": "string" }
              }
            }
          }
        }
      },
      "Credentials": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string" }
        }
      },
      "WorkspaceInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100, "example": "FlyRank demo" }
        }
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" },
          "role": { "type": "string", "enum": ["owner", "member"] }
        }
      },
      "BrandInput": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 100, "example": "FlyRank" },
          "aliases": {
            "type": "array",
            "maxItems": 20,
            "items": { "type": "string" },
            "example": ["FlyRank AI", "flyrank.ai"]
          },
          "fact_sheet": {
            "type": "object",
            "additionalProperties": true,
            "description": "Any JSON object, up to 20,000 characters. Current facts used to spot stale mentions.",
            "example": {
              "as_of": "2026-10-14",
              "pricing_usd_per_month": { "Sparrow": 1999, "Owl": 3499, "Eagle": 4999, "Phoenix": 9999 },
              "engines_tracked": ["ChatGPT", "Perplexity", "Claude", "Gemini"]
            }
          }
        }
      },
      "BrandUpdate": {
        "type": "object",
        "description": "Any subset of the brand fields; at least one is required.",
        "properties": {
          "name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "fact_sheet": { "type": "object", "additionalProperties": true }
        }
      },
      "Brand": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspace_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "fact_sheet": { "type": "object", "additionalProperties": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Intent": {
        "type": "string",
        "enum": ["recommendation", "comparison", "alternatives", "pricing", "use_case", "evaluation", "how_to"]
      },
      "CategoryInput": {
        "type": "object",
        "required": ["brand_id", "name"],
        "properties": {
          "brand_id": { "type": "string", "format": "uuid", "description": "Must be a brand in the same workspace" },
          "name": { "type": "string", "maxLength": 100, "example": "AI search visibility / GEO tools" },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "description": "Given to the query generator as context",
            "example": "Software and agencies that help brands get cited and recommended by AI assistants like ChatGPT, Gemini and Perplexity"
          }
        }
      },
      "CategoryUpdate": {
        "type": "object",
        "description": "name and/or description; brand_id cannot be changed",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true }
        }
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "workspace_id": { "type": "string", "format": "uuid" },
          "brand_id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "active_query_count": { "type": "integer" }
        }
      },
      "Query": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "category_id": { "type": "string", "format": "uuid" },
          "text": { "type": "string" },
          "intent": { "allOf": [{ "$ref": "#/components/schemas/Intent" }], "nullable": true },
          "variant_of": { "type": "string", "format": "uuid", "nullable": true, "description": "The seed query this paraphrases; null for seeds" },
          "active": { "type": "boolean", "description": "Inactive queries are skipped by harvests" },
          "origin": { "type": "string", "enum": ["generated", "manual"] },
          "generation_model": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "GeneratedQuery": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "intent": { "$ref": "#/components/schemas/Intent" },
          "group": { "type": "integer", "description": "Paraphrases of one underlying need share a group" },
          "is_seed": { "type": "boolean", "description": "First phrasing in its group" }
        }
      },
      "GenerateResult": {
        "type": "object",
        "properties": {
          "saved": { "type": "boolean" },
          "model": { "type": "string" },
          "prompt_version": { "type": "string" },
          "requested": { "type": "integer" },
          "queries": {
            "type": "array",
            "description": "GeneratedQuery items when previewing; saved Query rows when save=true",
            "items": { "oneOf": [{ "$ref": "#/components/schemas/GeneratedQuery" }, { "$ref": "#/components/schemas/Query" }] }
          },
          "dropped": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "reason": { "type": "string", "enum": ["duplicate", "mentions_brand", "too_short"] }
              }
            }
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid or expired access token",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "Not found, or belongs to a workspace you are not a member of",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "BadRequest": {
        "description": "Request body failed validation",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } } }
      },
      "Forbidden": {
        "description": "You are a member of the workspace but lack the required role",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Conflict": {
        "description": "Would create a duplicate",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "API info",
        "operationId": "getInfo",
        "tags": ["General"],
        "responses": {
          "200": {
            "description": "API information",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "version": { "type": "string" },
                    "description": { "type": "string" },
                    "docs": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Checks the database connection and reports the latest applied migration.",
        "operationId": "getHealth",
        "tags": ["General"],
        "responses": {
          "200": {
            "description": "Service and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "database": { "type": "string", "example": "connected" },
                    "migration": { "type": "string", "nullable": true, "example": "001_init.sql" }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "degraded" },
                    "database": { "type": "string", "example": "unreachable" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "Create an account",
        "description": "If email confirmation is enabled in Supabase, `confirmation_required` is true and login works only after confirming.",
        "operationId": "signup",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" },
                    "confirmation_required": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Log in and get an access token",
        "operationId": "login",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Credentials" } } }
        },
        "responses": {
          "200": {
            "description": "Tokens",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" },
                    "refresh_token": { "type": "string" },
                    "expires_at": { "type": "integer", "description": "Unix seconds" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "Invalid login credentials",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Who the access token belongs to",
        "operationId": "getMe",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/workspaces": {
      "post": {
        "summary": "Create a workspace (you become its owner)",
        "operationId": "createWorkspace",
        "tags": ["Workspaces"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceInput" } } }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "get": {
        "summary": "List workspaces you are a member of",
        "operationId": "listWorkspaces",
        "tags": ["Workspaces"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Your workspaces",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Workspace" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/workspaces/{workspaceId}": {
      "parameters": [{ "$ref": "#/components/parameters/workspaceId" }],
      "get": {
        "summary": "Get a workspace",
        "operationId": "getWorkspace",
        "tags": ["Workspaces"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Workspace with your role in it",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "summary": "Rename a workspace (owner only)",
        "operationId": "renameWorkspace",
        "tags": ["Workspaces"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WorkspaceInput" } } }
        },
        "responses": {
          "200": {
            "description": "Renamed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Workspace" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Delete a workspace and everything in it (owner only)",
        "operationId": "deleteWorkspace",
        "tags": ["Workspaces"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/workspaces/{workspaceId}/brands": {
      "parameters": [{ "$ref": "#/components/parameters/workspaceId" }],
      "post": {
        "summary": "Create a brand",
        "operationId": "createBrand",
        "tags": ["Brands"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrandInput" } } }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Brand" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "get": {
        "summary": "List brands in a workspace",
        "operationId": "listBrands",
        "tags": ["Brands"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Brands",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Brand" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/workspaces/{workspaceId}/brands/{brandId}": {
      "parameters": [
        { "$ref": "#/components/parameters/workspaceId" },
        { "$ref": "#/components/parameters/brandId" }
      ],
      "get": {
        "summary": "Get a brand",
        "operationId": "getBrand",
        "tags": ["Brands"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Brand",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Brand" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "summary": "Update a brand (any subset of fields, e.g. just the fact sheet)",
        "operationId": "updateBrand",
        "tags": ["Brands"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BrandUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Brand" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Delete a brand",
        "operationId": "deleteBrand",
        "tags": ["Brands"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/workspaces/{workspaceId}/categories": {
      "parameters": [{ "$ref": "#/components/parameters/workspaceId" }],
      "post": {
        "summary": "Create a category",
        "operationId": "createCategory",
        "tags": ["Categories"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryInput" } } }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "get": {
        "summary": "List categories",
        "operationId": "listCategories",
        "tags": ["Categories"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Categories",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/workspaces/{workspaceId}/categories/{categoryId}": {
      "parameters": [
        { "$ref": "#/components/parameters/workspaceId" },
        { "$ref": "#/components/parameters/categoryId" }
      ],
      "get": {
        "summary": "Get a category",
        "operationId": "getCategory",
        "tags": ["Categories"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Category",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "summary": "Update a category's name or description",
        "operationId": "updateCategory",
        "tags": ["Categories"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryUpdate" } } }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "summary": "Delete a category and its queries",
        "operationId": "deleteCategory",
        "tags": ["Categories"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/workspaces/{workspaceId}/categories/{categoryId}/queries/generate": {
      "parameters": [
        { "$ref": "#/components/parameters/workspaceId" },
        { "$ref": "#/components/parameters/categoryId" }
      ],
      "post": {
        "summary": "Generate a conversational query set with the LLM",
        "description": "Asks Gemini for groups of paraphrased buyer questions about the category, then drops duplicates (including ones already saved), fragments, and any query naming the brand or its aliases, so measurements stay category-level. With `save: false` (default) nothing is stored, so you can review the set first.",
        "operationId": "generateQueries",
        "tags": ["Queries"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "count": { "type": "integer", "minimum": 5, "maximum": 100, "default": 60 },
                  "save": { "type": "boolean", "default": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preview (not saved)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateResult" } } }
          },
          "201": {
            "description": "Saved",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GenerateResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": {
            "description": "LLM rate limit reached (after retries)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "502": {
            "description": "LLM request failed or returned unusable output",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "503": {
            "description": "LLM not configured (GEMINI_API_KEY missing)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/workspaces/{workspaceId}/categories/{categoryId}/queries": {
      "parameters": [
        { "$ref": "#/components/parameters/workspaceId" },
        { "$ref": "#/components/parameters/categoryId" }
      ],
      "get": {
        "summary": "List queries",
        "operationId": "listQueries",
        "tags": ["Queries"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "active", "in": "query", "required": false, "schema": { "type": "string", "enum": ["true", "false"] } }
        ],
        "responses": {
          "200": {
            "description": "Queries",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Query" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "summary": "Add queries by hand",
        "description": "Queries already in the category are skipped, not rejected.",
        "operationId": "addQueries",
        "tags": ["Queries"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["queries"],
                "properties": {
                  "queries": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "required": ["text"],
                      "properties": {
                        "text": { "type": "string", "example": "how do i get my brand mentioned in chatgpt answers" },
                        "intent": { "$ref": "#/components/schemas/Intent" }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "added": { "type": "integer" },
                    "skipped_duplicates": { "type": "integer" },
                    "queries": { "type": "array", "items": { "$ref": "#/components/schemas/Query" } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/workspaces/{workspaceId}/categories/{categoryId}/queries/{queryId}": {
      "parameters": [
        { "$ref": "#/components/parameters/workspaceId" },
        { "$ref": "#/components/parameters/categoryId" },
        { "$ref": "#/components/parameters/queryId" }
      ],
      "patch": {
        "summary": "Edit or deactivate a query",
        "operationId": "updateQuery",
        "tags": ["Queries"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": { "type": "string" },
                  "intent": { "allOf": [{ "$ref": "#/components/schemas/Intent" }], "nullable": true },
                  "active": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Query" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      },
      "delete": {
        "summary": "Delete a query",
        "operationId": "deleteQuery",
        "tags": ["Queries"],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "204": { "description": "Deleted" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  }
}
